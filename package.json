{
  "name": "buildzn-sales-call-to-crm-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "demo": "node --import tsx src/demo.ts",
    "scan": "node scripts/scan.mjs",
    "format:check": "prettier --check src tests scripts *.json *.yml .github/workflows/*.yml *.md docs/*.md"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
